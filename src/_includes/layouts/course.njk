<!DOCTYPE html><!--  This site was created in Webflow. https://webflow.com  --><!--  Last Published: Tue Sep 29 2026 20:21:54 GMT+0000 (Coordinated Universal Time)  -->
<html data-wf-page="60d2479a4b12f134fe3a01d2" data-wf-site="60d2479a4b12f12cea3a01bf">
<head>
  <meta charset="utf-8">
  <title>{{ title }} - Blu Veda</title>
  <meta content="{{ moduleDescription }}" name="description">
  <meta content="{{ title }} - Blu Veda" property="og:title">
  <meta content="{{ moduleDescription }}" property="og:description">
  <meta content="{{ siteUrl + image if image.startsWith('/') else image }}" property="og:image">
  <meta content="{{ title }} - Blu Veda" name="twitter:title">
  <meta content="{{ moduleDescription }}" name="twitter:description">
  <meta content="{{ siteUrl + image if image.startsWith('/') else image }}" name="twitter:image">
  <meta property="og:type" content="website">
  <meta content="summary_large_image" name="twitter:card">
  <meta content="width=device-width, initial-scale=1" name="viewport">
  <meta content="Webflow" name="generator">
  <link href="/css/normalize.css" rel="stylesheet" type="text/css">
  <link href="/css/webflow.css" rel="stylesheet" type="text/css">
  <link href="/css/blue-veda.webflow.css" rel="stylesheet" type="text/css">
  <link href="/css/site.css" rel="stylesheet" type="text/css">
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous">
  <script src="https://ajax.googleapis.com/ajax/libs/webfont/1.6.26/webfont.js" type="text/javascript"></script>
  <script type="text/javascript">WebFont.load({  google: {    families: ["Arvo:300,400,500,600,700","Courier Prime:300,400,500,600,700","Cutive Mono:300,400,500,600,700","Permanent Marker:300,400,500,600,700","Red Hat Display:300,400,500,600,700","Special Elite:300,400,500,600,700"]  }});</script>
  <script type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
  <link href="/images/favicon.png" rel="shortcut icon" type="image/x-icon">
  <link href="/images/webclip.webp" rel="apple-touch-icon">
</head>
<body{% if imageRatio %} class="course-uniform-images" style="--course-image-ratio: {{ imageRatio }}"{% endif %}>
  <div class="section-2">
    <div class="div-block-3">
      <div class="text-block-64">YOGA • HEALING • INNER HARMONY</div>
    </div>
  </div>
  {% include "nav.njk" %}
  <div class="section about-hero page-intro page-intro--course">
    <div class="page-intro__grid">
      <div class="page-intro__media">
        {%- if image %}<img src="{{ image }}" width="480" alt="{{ title }}" class="course-photo course-photo--hero">{% endif %}
      </div>
      <div class="page-intro__content">
        <div class="label _30-margin">Yoga &bull; Healing &bull; Inner harmony</div>
        <h1 class="heading1specialabout page-intro__title">{{ title }}</h1>
        {%- if moduleDescription %}
        <p class="page-intro__lead page-intro__lead--accent">{{ moduleDescription }}</p>
        {%- endif %}
        {%- if courseTypesOffers %}
        <p class="page-intro__text">{{ courseTypesOffers }}</p>
        {%- endif %}
        {%- if duration or price %}
        <dl class="course-facts">
          {%- if duration %}<div><dt>Duration</dt><dd>{{ duration }}</dd></div>{% endif %}
          {%- if price %}<div><dt>Price</dt><dd>{{ price }}</dd></div>{% endif %}
        </dl>
        {%- endif %}
        <a href="/contact" class="button page-intro__button w-button">Book a session</a>
      </div>
    </div>
  </div>

  <div class="section course-body">
    <div class="course-body__inner">
      {%- if content | trim %}
      <div class="course-body__copy w-richtext">
{{ content | safe }}
      </div>
      {%- endif %}
      {%- if image3 %}
      <img src="{{ image3 }}" loading="lazy" width="480" alt="" class="course-photo">
      {%- endif %}

      {%- if serviceGroups %}
      <div class="services">
        <div class="services__header">
          <div class="label _30-margin">{{ servicesTitle or "Treatments" }}</div>
          {%- if servicesIntro %}
          <p class="services__intro">{{ servicesIntro }}</p>
          {%- endif %}
        </div>
        {%- for group in serviceGroups %}
        {%- if group.image %}
        <img src="{{ group.image }}" loading="lazy" width="480" alt="{{ group.imageAlt }}" class="course-photo">
        {%- endif %}
        <section class="service-group">
          <h2 class="service-group__title">{{ group.title }}</h2>
          {%- if group.subtitle %}
          <p class="service-group__subtitle">{{ group.subtitle }}</p>
          {%- endif %}
          <div class="service-list">
            {%- for service in group.services %}
            <article class="service">
              <div class="service__header">
                <div class="service__name-wrap">
                  <h3 class="service__name">{{ service.name }}</h3>
                  {%- if service.subtitle %}
                  <p class="service__subtitle">{{ service.subtitle }}</p>
                  {%- endif %}
                </div>
                {%- if service.price or service.duration %}
                <div class="service__meta">
                  {%- if service.price %}<span class="service__price">{{ service.price }}</span>{% endif %}
                  {%- if service.duration %}<span class="service__duration">{{ service.duration }}</span>{% endif %}
                </div>
                {%- endif %}
              </div>
              {%- for paragraph in service.description %}
              <p class="service__text">{{ paragraph }}</p>
              {%- endfor %}
            </article>
            {%- endfor %}
          </div>
        </section>
        {%- endfor %}
      </div>
      {%- endif %}

      {%- if image2 %}
      <img src="{{ image2 }}" loading="lazy" width="480" alt="" class="course-photo">
      {%- endif %}
    </div>
  </div>

  <div class="section page-cta">
    <div class="label _30-margin">Work with me</div>
    <h2 class="heading-14 page-cta__title">{{ ctaTitle or "Ready to book a session?" }}</h2>
    {%- if ctaText %}
    <p class="page-cta__text">{{ ctaText }}</p>
    {%- endif %}
    <a href="/contact" class="button page-cta__button w-button">{{ ctaButton or "Book a session" }}</a>
  </div>
  <div class="page-wrap">
    <div data-w-id="82132cc5-094e-04d8-bf08-ac350a8660df" class="section free-classes">
      <div class="container free-plan-container">
        {%- set cardCourses = collections.courses | publishedCourses | exceptSlug(slug) %}
        {%- if cardCourses.length %}
        <div class="label _30-margin course-list-heading">Also offered</div>
        {%- endif %}
        {% include "course-cards.njk" %}
      </div>
    </div>
    {% include "footer.njk" %}
  </div>
  <script src="/js/jquery-3.5.1.min.js" type="text/javascript"></script>
  <script src="/js/webflow.js" type="text/javascript"></script>
  <style>
body{
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
</style>
</body>
</html>